{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OmniPort",
  "version": "0.1.0",
  "identifier": "com.omniport.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OmniPort — Virtual Serial Router & Dissector",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        "default"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
